# ── Required ─────────────────────────────────────────────────────────────

# Any Postgres connection string (Neon, Supabase, RDS, local…).
# Tables are created automatically on first use — no migration step.
DATABASE_URL=postgres://user:pass@host:5432/connectbot

# Protects the admin console at /console.
ADMIN_PASSWORD=change-me

# ── Optional: AI auto-reply ──────────────────────────────────────────────
# Leave OPENAI_API_KEY unset to disable AI entirely.

# OPENAI_API_KEY=sk-...
# Any OpenAI-compatible endpoint (OpenAI, DeepSeek, OpenRouter, Ollama…).
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# ── Optional ─────────────────────────────────────────────────────────────

# The public site id carried by the embed snippet. Cosmetic on a
# single-tenant deployment; defaults to "default".
# SITE_ID=default

# Initial site name (shown in the widget header as “… from <name>”).
# SITE_NAME=My website
